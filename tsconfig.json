{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "strict": true,
    "rootDir": "src",  
    "outDir": "dist",
    "resolveJsonModule": true,
    // "skipLibCheck": false,
    "types": ["node"],
    "skipLibCheck": true  
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/node_modules", "**/dist"]
}
