# Sentry Configuration
SENTRY_DSN=your_sentry_dsn_here

# Other existing environment variables...
NODE_ENV=development

# ---------------------------------------------------------------------------
# Website contact form (POST /contact)
# ---------------------------------------------------------------------------
# Where enquiries from softinvite.com/contact are emailed. Reply-To on the
# notification is set to the enquirer, so replying reaches them directly.
CONTACT_INBOX_EMAIL=softinvites@gmail.com
CONTACT_FROM_EMAIL=SoftInvites Website <info@softinvite.com>

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# softinvite.com (both apex and www), the localhost dev ports and the scanner
# are always allowed — see the allowedOrigins array in src/index.ts.
#
# EXTRA_CORS_ORIGINS adds more without a code change. Use it to test the
# marketing site on its Vercel preview URL before it goes on the domain.
# Comma-separated, no trailing slashes.
EXTRA_CORS_ORIGINS=

# Allow ANY https://*.vercel.app origin. Handy while testing preview deploys,
# but it opens the API to every Vercel-hosted site — leave unset in production.
ALLOW_VERCEL_PREVIEW_ORIGINS=false
